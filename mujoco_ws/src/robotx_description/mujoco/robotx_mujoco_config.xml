<actuator>
  <position name="joint1" joint="joint1" kp="50" ctrlrange="-1.57 1.57"/>
  <position name="joint2" joint="joint2" kp="50" ctrlrange="-1.57 1.57"/>
  <position name="joint3" joint="joint3" kp="50" ctrlrange="-1.57 1.57"/>
  <position name="joint4" joint="joint4" kp="50" ctrlrange="-1.57 1.57"/>
  <position name="joint5" joint="joint5" kp="50" ctrlrange="-1.57 1.57"/>
  <position name="joint5a1" joint="joint5a1" kp="50" ctrlrange="-1.57 1.57"/>
