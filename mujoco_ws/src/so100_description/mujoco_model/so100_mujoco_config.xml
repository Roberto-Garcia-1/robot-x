<contact>
<exclude body1="world"          body2="shoulder"/>
<exclude body1="world"          body2="upper_arm"/>
<exclude body1="gripper"    body2="lower_arm"/>
<exclude body1="gripper"    body2="jaw"/>
<exclude body1="gripper"    body2="wrist"/>
<exclude body1="lower_arm"     body2="jaw"/>
<exclude body1="lower_arm"     body2="upper_arm"/>
<exclude body1="lower_arm"     body2="wrist"/>
<exclude body1="jaw"        body2="wrist"/>
<exclude body1="shoulder"       body2="upper_arm"/>
</contact>