<contact>
  <exclude body1="world" body2="link1"/>
  <exclude body1="link5a1" body2="link5b1"/>
  <exclude body1="link5a2" body2="link5a3"/>
  <exclude body1="link5b2" body2="link5b3"/>
</contact>